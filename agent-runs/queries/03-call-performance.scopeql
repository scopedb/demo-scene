FROM guide_agents.spans
WHERE run_id = 'agent-first'
    AND name IN ('claude_code.llm_request', 'claude_code.tool')
SELECT name, duration_ns,
    TRY(var['tool_name']::string) AS tool,
    TRY(var['model']::string) AS model
GROUP BY name, tool, model
AGGREGATE count() AS calls,
    sum(duration_ns) / 1000000.0 AS cumulative_ms,
    max(duration_ns) / 1000000.0 AS max_ms
ORDER BY cumulative_ms DESC, name, tool
