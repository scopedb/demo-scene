FROM guide_agents.spans
WHERE var['run_id']::string = 'agent-first'
SELECT step, status, duration_ms,
    TRY(var['tool']::string) AS tool,
    TRY(var['attempt']::int) AS attempt
GROUP BY step, tool
AGGREGATE count() AS spans,
    sum(if(status = 'error', 1, 0)) AS errors,
    sum(if(attempt > 1, 1, 0)) AS retries,
    max(duration_ms) AS max_ms
ORDER BY errors DESC, max_ms DESC, step
