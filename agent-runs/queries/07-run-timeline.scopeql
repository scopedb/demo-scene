FROM guide_agents.codex_spans
WHERE run_id = 'agent-first'
    AND name IN ('run_turn', 'try_run_sampling_request', 'exec', 'exec_command', 'unified_exec.exec_command')
SELECT time, end_time, trace_id, span_id, parent_span_id, name, status,
    duration_ns / 1000000.0 AS duration_ms, model, tool, call_id
ORDER BY time, trace_id, span_id
